SIMULATOR_SECRET=replace-with-at-least-24-random-characters
WEBHOOK_SECRET=replace-with-a-different-random-secret
OPERATOR_SECRET=replace-with-a-third-random-secret
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
DD_MONITOR_ID=
DD_TRIAL_ID=hackathon-2026

# Operator login. Easiest: python scripts/init_env.py --operator-user operator
# By hand: python -m chargeops.auth hash, then paste the result unchanged inside single quotes.
# Compose and pydantic-settings both read a single-quoted value literally (no `$` interpolation),
# so the same line works for containers and host runs. Example: 'scrypt$16384$8$1$<salt>$<digest>'
# Do not write `$$`: Compose would unescape it, but host runs would read `$$` literally and login fails.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=

# Browser origins allowed to use the operator session cookie (web UI is served on :8080).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Set true to run api/worker/simulator under ddtrace-run (needs the observability profile).
DD_TRACE_ENABLED=false
# Set true with the observability profile: worker heartbeat metric for the liveness monitor.
DD_METRICS_ENABLED=false
# Version tag for the image build and Datadog unified service tagging.
APP_VERSION=0.1.0
# Live simulator realism: diurnal per-station ambient (HCMC profile) and sensor noise. Tests run without it.
SIM_REALISM=true
# datadog-sync (observability profile) reuses DD_API_KEY, DD_APP_KEY (Incidents/Notebooks scopes) and DD_SITE.

# Datadog Browser RUM (public identifiers, baked in at web build time). Tạo RUM application (JS) trên Datadog, rồi build lại web.
DD_RUM_APPLICATION_ID=
DD_RUM_CLIENT_TOKEN=
