{
  "name": "ChargeOps - xu ly su co",
  "description": "List open ChargeOps incidents and send gated commands (acknowledge, reduce load, maintenance, verify recovery). A human click is required; the worker re-checks every gate.",
  "rootInstanceName": "grid0",
  "components": [
    {
      "name": "grid0",
      "type": "grid",
      "properties": {
        "children": [
          {
            "name": "titleCell",
            "type": "gridCell",
            "properties": {
              "children": [
                {
                  "name": "title",
                  "type": "text",
                  "properties": {
                    "value": "# ChargeOps - su co dang mo"
                  }
                }
              ],
              "isVisible": true,
              "layout": {
                "x": 0,
                "y": 0,
                "width": 12,
                "height": 2
              }
            }
          },
          {
            "name": "tableCell",
            "type": "gridCell",
            "properties": {
              "children": [
                {
                  "name": "incidentsTable",
                  "type": "table",
                  "properties": {
                    "data": "${listIncidents.outputs.body.items}",
                    "columns": [
                      {
                        "dataPath": "incident_id",
                        "header": "Incident"
                      },
                      {
                        "dataPath": "station_id",
                        "header": "Tram"
                      },
                      {
                        "dataPath": "connector_id",
                        "header": "Connector"
                      },
                      {
                        "dataPath": "state",
                        "header": "Trang thai"
                      },
                      {
                        "dataPath": "allowed_commands",
                        "header": "Lenh cho phep"
                      }
                    ],
                    "selectionType": "single"
                  },
                  "events": []
                }
              ],
              "isVisible": true,
              "layout": {
                "x": 0,
                "y": 2,
                "width": 12,
                "height": 8
              }
            }
          },
          {
            "name": "ackCell",
            "type": "gridCell",
            "properties": {
              "children": [
                {
                  "name": "ackButton",
                  "type": "button",
                  "properties": {
                    "label": "Xac nhan",
                    "isDisabled": "${!(incidentsTable.selectedRow?.allowed_commands || []).includes('acknowledge')}"
                  },
                  "events": [
                    {
                      "name": "click",
                      "type": "triggerQuery",
                      "queryName": "actAcknowledge"
                    }
                  ]
                }
              ],
              "isVisible": true,
              "layout": {
                "x": 0,
                "y": 10,
                "width": 3,
                "height": 2
              }
            }
          },
          {
            "name": "reduceCell",
            "type": "gridCell",
            "properties": {
              "children": [
                {
                  "name": "reduceButton",
                  "type": "button",
                  "properties": {
                    "label": "Giam tai",
                    "isDisabled": "${!(incidentsTable.selectedRow?.allowed_commands || []).includes('reduce_load')}"
                  },
                  "events": [
                    {
                      "name": "click",
                      "type": "triggerQuery",
                      "queryName": "actReduceLoad"
                    }
                  ]
                }
              ],
              "isVisible": true,
              "layout": {
                "x": 3,
                "y": 10,
                "width": 3,
                "height": 2
              }
            }
          },
          {
            "name": "maintenanceCell",
            "type": "gridCell",
            "properties": {
              "children": [
                {
                  "name": "maintenanceButton",
                  "type": "button",
                  "properties": {
                    "label": "Bao tri",
                    "isDisabled": "${!(incidentsTable.selectedRow?.allowed_commands || []).includes('maintenance')}"
                  },
                  "events": [
                    {
                      "name": "click",
                      "type": "triggerQuery",
                      "queryName": "actMaintenance"
                    }
                  ]
                }
              ],
              "isVisible": true,
              "layout": {
                "x": 6,
                "y": 10,
                "width": 3,
                "height": 2
              }
            }
          },
          {
            "name": "verifyCell",
            "type": "gridCell",
            "properties": {
              "children": [
                {
                  "name": "verifyButton",
                  "type": "button",
                  "properties": {
                    "label": "Kiem tra phuc hoi",
                    "isDisabled": "${!(incidentsTable.selectedRow?.allowed_commands || []).includes('verify_recovery')}"
                  },
                  "events": [
                    {
                      "name": "click",
                      "type": "triggerQuery",
                      "queryName": "actVerifyRecovery"
                    }
                  ]
                }
              ],
              "isVisible": true,
              "layout": {
                "x": 9,
                "y": 10,
                "width": 3,
                "height": 2
              }
            }
          }
        ]
      },
      "events": []
    }
  ],
  "queries": [
    {
      "id": "6f1d1c52-3a0e-4c53-9b1a-0a1f6c2e7a01",
      "name": "listIncidents",
      "type": "action",
      "events": [],
      "properties": {
        "spec": {
          "fqn": "com.datadoghq.http.request",
          "connectionId": "__CONNECTION_ID__",
          "inputs": {
            "verb": "GET",
            "url": "__TUNNEL__/api/v1/integrations/datadog/incidents"
          }
        },
        "onlyTriggerManually": false
      }
    },
    {
      "id": "6f1d1c52-3a0e-4c53-9b1a-0a1f6c2e7a02",
      "name": "actAcknowledge",
      "type": "action",
      "events": [
        {
          "name": "executionFinished",
          "type": "triggerQuery",
          "queryName": "listIncidents"
        }
      ],
      "properties": {
        "spec": {
          "fqn": "com.datadoghq.http.request",
          "connectionId": "__CONNECTION_ID__",
          "inputs": {
            "verb": "POST",
            "url": "__TUNNEL__/api/v1/integrations/datadog/actions",
            "headers": [
              {
                "key": "Idempotency-Key",
                "value": [
                  "${'dd-' + incidentsTable.selectedRow?.incident_id + '-acknowledge-' + Date.now()}"
                ]
              }
            ],
            "body": {
              "incident_id": "${incidentsTable.selectedRow?.incident_id}",
              "command": "acknowledge"
            },
            "bodyType": "application/json"
          }
        },
        "onlyTriggerManually": true
      }
    },
    {
      "id": "6f1d1c52-3a0e-4c53-9b1a-0a1f6c2e7a03",
      "name": "actReduceLoad",
      "type": "action",
      "events": [
        {
          "name": "executionFinished",
          "type": "triggerQuery",
          "queryName": "listIncidents"
        }
      ],
      "properties": {
        "spec": {
          "fqn": "com.datadoghq.http.request",
          "connectionId": "__CONNECTION_ID__",
          "inputs": {
            "verb": "POST",
            "url": "__TUNNEL__/api/v1/integrations/datadog/actions",
            "headers": [
              {
                "key": "Idempotency-Key",
                "value": [
                  "${'dd-' + incidentsTable.selectedRow?.incident_id + '-reduce_load-' + Date.now()}"
                ]
              }
            ],
            "body": {
              "incident_id": "${incidentsTable.selectedRow?.incident_id}",
              "command": "reduce_load"
            },
            "bodyType": "application/json"
          }
        },
        "onlyTriggerManually": true
      }
    },
    {
      "id": "6f1d1c52-3a0e-4c53-9b1a-0a1f6c2e7a04",
      "name": "actMaintenance",
      "type": "action",
      "events": [
        {
          "name": "executionFinished",
          "type": "triggerQuery",
          "queryName": "listIncidents"
        }
      ],
      "properties": {
        "spec": {
          "fqn": "com.datadoghq.http.request",
          "connectionId": "__CONNECTION_ID__",
          "inputs": {
            "verb": "POST",
            "url": "__TUNNEL__/api/v1/integrations/datadog/actions",
            "headers": [
              {
                "key": "Idempotency-Key",
                "value": [
                  "${'dd-' + incidentsTable.selectedRow?.incident_id + '-maintenance-' + Date.now()}"
                ]
              }
            ],
            "body": {
              "incident_id": "${incidentsTable.selectedRow?.incident_id}",
              "command": "maintenance"
            },
            "bodyType": "application/json"
          }
        },
        "onlyTriggerManually": true
      }
    },
    {
      "id": "6f1d1c52-3a0e-4c53-9b1a-0a1f6c2e7a05",
      "name": "actVerifyRecovery",
      "type": "action",
      "events": [
        {
          "name": "executionFinished",
          "type": "triggerQuery",
          "queryName": "listIncidents"
        }
      ],
      "properties": {
        "spec": {
          "fqn": "com.datadoghq.http.request",
          "connectionId": "__CONNECTION_ID__",
          "inputs": {
            "verb": "POST",
            "url": "__TUNNEL__/api/v1/integrations/datadog/actions",
            "headers": [
              {
                "key": "Idempotency-Key",
                "value": [
                  "${'dd-' + incidentsTable.selectedRow?.incident_id + '-verify_recovery-' + Date.now()}"
                ]
              }
            ],
            "body": {
              "incident_id": "${incidentsTable.selectedRow?.incident_id}",
              "command": "verify_recovery"
            },
            "bodyType": "application/json"
          }
        },
        "onlyTriggerManually": true
      }
    }
  ]
}
